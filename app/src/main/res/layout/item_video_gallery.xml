<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-compat"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Video Thumbnail Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <!-- Video Thumbnail -->
            <ImageView
                android:id="@+id/videoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_video" />

            <!-- Overlay Gradient -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/video_overlay_gradient" />

            <!-- Duration Badge -->
            <TextView
                android:id="@+id/videoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="@drawable/duration_badge_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="10s"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Visibility Indicator -->
            <ImageView
                android:id="@+id/visibilityIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/visibility_badge_background"
                android:padding="3dp"
                android:src="@drawable/ic_public"
                android:tint="@android:color/white" />

            <!-- Mode Indicator -->
            <TextView
                android:id="@+id/modeIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/mode_badge_background"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:text="T2V"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Quality Indicator -->
            <TextView
                android:id="@+id/qualityIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/quality_badge_background"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:text="HD"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Video Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Video Title -->
            <TextView
                android:id="@+id/videoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Beautiful sunset over ocean waves"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Beautiful sunset over ocean waves" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/videoTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2h ago"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="2 hours ago" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Share Button -->
                <ImageButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Share"
                    android:src="@drawable/ic_share"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Regenerate Button -->
                <ImageButton
                    android:id="@+id/regenerateButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Regenerate"
                    android:src="@drawable/ic_refresh"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <!-- Delete Button -->
                <ImageButton
                    android:id="@+id/deleteButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete"
                    android:src="@drawable/ic_delete"
                    android:tint="?attr/colorError" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
